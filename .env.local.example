# Copie este arquivo pra .env.local (que está no .gitignore)
# e preencha com os valores reais do projeto Supabase.

NEXT_PUBLIC_SUPABASE_URL=https://<seu-projeto>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<sua-anon-key>

# Opcional — URL pública do site (afeta sitemap, OG e JSON-LD).
# Em local dev, deixe http://localhost:3000.
# Em produção, use o domínio final (ex.: https://barrilchopperia.com.br).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
